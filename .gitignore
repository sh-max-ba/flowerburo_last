# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build
public/uploads/products/*
!public/uploads/products/.gitkeep
public/uploads/bouquets/*
!public/uploads/bouquets/.gitkeep
public/uploads/orders/*
!public/uploads/orders/.gitkeep

# misc
.DS_Store
*.pem
app.db
app.db.backup*
app.db.bak*
app.db*.backup*
app.db-shm
app.db-wal
/backups/
*.disabled-launch

# uploaded customer media (voice messages etc.) — never commit
public/uploads/voice/*
!public/uploads/voice/.gitkeep

# runtime logs
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
