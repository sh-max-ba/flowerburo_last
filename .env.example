NODE_ENV=production
PORT=3000

# ОБЯЗАТЕЛЬНО в production: секрет для подписи сессионных cookie.
# Сгенерируйте сильное значение, например: openssl rand -base64 48
# В production приложение бросит ошибку при логине, если переменная не задана или короче 32 символов.
AUTH_SECRET=

# Флаг "secure" для сессионной cookie. По умолчанию true в production.
# Поставьте false ТОЛЬКО если отдаёте приложение по простому HTTP (без TLS) — иначе вход работать не будет.
SESSION_COOKIE_SECURE=

WAZZUP_API_KEY=
WAZZUP_CRM_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
